APP_ENV=""
REDIS_URL=""
# Redis-backed cache for the authenticated notifications feed. MongoDB stays
# the source of truth; an empty REDIS_URL or NOTIFICATIONS_CACHE_ENABLED=false
# bypasses caching entirely and reads/writes go straight to MongoDB.
NOTIFICATIONS_CACHE_ENABLED="true"
NOTIFICATIONS_CACHE_TTL="30s"
NOTIFICATIONS_CACHE_OP_TIMEOUT="100ms"
MONGODB_URI=""
PORT=""
SESSION_KEY=""
# SendGrid is used for employer vacancy-application notifications.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="notifications@fundis.co.ke"
SENDGRID_FROM_NAME="Fundis"
# Public base URL of this backend (e.g. https://api.fundis.co) — used to build
# canonical URLs for the crawlable vacancy share page and links sent via email/SMS.
API_PUBLIC_URL="https://staging-api.fundis.co.ke"
# Public base URL of the customer-facing frontend (e.g. https://app.fundis.co) —
# used as the "Apply" deep-link target and post-action redirects.
APP_PUBLIC_URL="https://app.fundis.co.ke"
CELLULANT_ACCESS_KEY=""
CELLULANT_SECRET_KEY=""
CELLULANT_IV_KEY=""
CELLULANT_SERVICE_CODE=""
CELLULANT_CHECKOUT_URL="https://online.uat.tingg.africa/testing/express/checkout"
CELLULANT_BASE_URL=""
CELLULANT_CLIENT_ID=""
CELLULANT_CLIENT_SECRET=""
CELLULANT_API_KEY=""
# Advanta Bulk SMS API (https://advanta.africa/bulk-sms-api) — used for OTP delivery
ADVANTA_API_KEY=""
ADVANTA_PARTNER_ID=""
ADVANTA_SHORTCODE=""
# Optional: override the API base URL (defaults to https://quicksms.advantasms.com)
ADVANTA_BASE_URL=""
# Cloudflare Turnstile secret key. Optional outside production; required in production.
TURNSTILE_SECRET_KEY=""
# Optional defense-in-depth check against the hostname returned by Turnstile.
TURNSTILE_HOSTNAME=""
# AWS credentials use the standard AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# variables. Never expose these values to the frontend.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional when using temporary AWS credentials.
AWS_SESSION_TOKEN=""
AWS_REGION="af-south-1"
# Region the S3 client signs requests for. Leave blank to reuse AWS_REGION —
# only set this when the bucket lives in a different region than everything
# else (presigned URLs fail with a region-signing mismatch otherwise).
AWS_S3_REGION=""
AWS_S3_BUCKET=""
# Stable canonical S3 or CloudFront base URL, without a trailing slash.
# The bucket can remain private; downloads use short-lived signed URLs.
# Leave blank to use https://<bucket>.s3.<region>.amazonaws.com.
AWS_S3_PUBLIC_BASE_URL=""
# Optional per-file limit in bytes. Defaults to 104857600 (100 MiB).
AWS_S3_MAX_UPLOAD_BYTES=""
# Slack incoming webhook URL for error/alert notifications (leave empty to disable)
SLACK_WEBHOOK_URL=""
# Slack incoming webhook URL for operations activity notifications (leave empty to disable)
SLACK_OPS_NOTIFS_URL=""
# Amazon Bedrock inference profile ID for CV parsing (structured extraction
# via tool use). Current-generation Claude models require an inference
# profile ID (not a bare model ID) — list available ones with:
#   aws bedrock list-inference-profiles --region <AWS_REGION>
# Must be enabled for model access. Defaults to Claude Haiku 4.5's "global."
# inference profile if unset, which works regardless of AWS_REGION (a
# region-prefixed profile like "eu." only works when the resolved region
# actually matches — and note that ~/.aws/config's default region, if it
# exports AWS_REGION into the shell, silently overrides .env's AWS_REGION).
BEDROCK_MODEL_ID=""
# Bedrock API key (bearer token) from the Bedrock console -> API keys.
# When set, the AWS SDK authenticates with this token instead of
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, so a Bedrock-only key can be used
# without granting IAM access-key credentials. Leave unset to use the
# IAM credential chain instead (same as the S3 client above).
AWS_BEARER_TOKEN_BEDROCK=""

# Stytch B2B (multi-tenant) authentication for employer accounts. All five are
# required when STYTCH_EMPLOYER_AUTH_ENABLED is true; startup fails naming the
# first missing one. Never log or expose STYTCH_SECRET or STYTCH_WEBHOOK_SECRET.
STYTCH_PROJECT_ID=""
STYTCH_SECRET=""
# Safe to expose to the frontend; used by the Stytch JS SDK.
STYTCH_PUBLIC_TOKEN=""
# "test" or "live".
STYTCH_ENV="test"
# Signing secret from the Stytch webhook configuration, whsec_-prefixed.
STYTCH_WEBHOOK_SECRET=""
# Master switch for employer Stytch authentication. False keeps every employer on
# the existing password/OTP/JWT flow and makes the five variables above optional.
STYTCH_EMPLOYER_AUTH_ENABLED="false"
# Keeps POST /api/v1/login working for employers who already hold an Account_Link.
# Set to false only after the migration is complete and verified; reverting to
# true is the rollback and requires no data change.
LEGACY_EMPLOYER_AUTH_ENABLED="true"

# Better Stack (Logtail) error log forwarding. Leave BETTERSTACK_SOURCE_TOKEN or
# BETTERSTACK_INGEST_URL empty to disable forwarding entirely; stdout logging is
# completely unaffected either way.
BETTERSTACK_SOURCE_TOKEN=""
# Required when forwarding is enabled. Must be an https URL with a host.
BETTERSTACK_INGEST_URL=""
# Defaults to fundis-backend. Truncated to 64 characters.
BETTERSTACK_SERVICE_NAME=""
# "error" (default), "warn", or "info".
BETTERSTACK_MIN_LEVEL=""
# Max events per HTTP request, 1-1000. Defaults to 20.
BETTERSTACK_BATCH_SIZE=""
# Flush interval in seconds, 1-300. Defaults to 5.
BETTERSTACK_FLUSH_SECONDS=""
# In-memory queue capacity in events, 1-100000. Defaults to 1000.
BETTERSTACK_QUEUE_SIZE=""

# Zoho Meeting configuration for oral assessment video calls.
# OAuth2 credentials from Zoho API Console (Self Client or Server-based Application).
ZOHO_MEETING_CLIENT_ID=""
ZOHO_MEETING_CLIENT_SECRET=""
ZOHO_MEETING_REFRESH_TOKEN=""
# Zoho organisation ID (visible in Zoho Meeting admin panel URL).
ZOHO_MEETING_ZSOID=""
# Zoho user ID of the presenter/host account (numeric).
ZOHO_MEETING_PRESENTER_ID=""
# All five variables above are required together; if any is empty, oral bookings
# still succeed but carry no video link.
# Zoho datacenter hosts. Override for a non-.com org (.eu, .in, .com.au) — Zoho
# does not replicate accounts across datacenters, so these must match the org.
ZOHO_ACCOUNTS_BASE_URL=""
ZOHO_MEETING_BASE_URL=""
# IANA zone Zoho interprets meeting start times in. Must be a zone name, not an
# offset, so DST is handled by tzdata. Defaults to Africa/Nairobi.
ZOHO_MEETING_TIMEZONE=""

# AWS Bedrock AI scoring. Leave empty to disable AI scoring (falls back to human review).
BEDROCK_REGION=""
BEDROCK_MODEL_ID=""

# How close to an assessment an artisan may still cancel in order to rebook.
# Go duration string (e.g. 12h, 24h, 6h30m). Invalid or non-positive values fall
# back to 12h. Defaults to 12h.
ASSESSMENT_RESCHEDULE_CUTOFF=""
